# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Speech recognition
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Multilingual embeddings
EMBED_MODEL=BAAI/bge-m3

# Local document storage
DATA_DIR=./data
CHROMA_DIR=./data/chroma
PDF_DIR=./data/pdfs

# Speech output: edge uses an internet connection; piper runs locally
TTS_ENGINE=edge
EDGE_VOICE_EN=en-US-JennyNeural
EDGE_VOICE_UR=ur-PK-UzmaNeural
PIPER_VOICE_EN=./voices/en_US-amy-medium.onnx
PIPER_VOICE_UR=./voices/ur_PK-fasih-medium.onnx
PIPER_EXE=./piper/piper.exe
ESPEAK_DATA_DIR=./piper/espeak-ng-data

# Retrieval
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120
